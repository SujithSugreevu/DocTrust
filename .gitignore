# ==============================================================================
# DocTrust — Git Ignore Rules
# ==============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER commit sensitive configuration or cryptographic secrets to version control.
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ── Dependencies & Package Managers ──────────────────────────────────────────
node_modules/
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Frontend & Build Outputs (Vite / React) ───────────────────────────────────
dist/
dist-ssr/
build/
.cache/
.parcel-cache/
.turbo/
.eslintcache

# ── Python / Django ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
eggs/
develop-eggs/
downloads/
parts/
bin/
var/
sdist/
wheel/
*.manifest
*.spec

# Django media, staticfiles & SQLite databases
backend/media/
media/
backend/uploads/
uploads/
backend/storage/
storage/
backend/staticfiles/
staticfiles/
db.sqlite3
db.sqlite3-journal

# ── Testing, Coverage & Linters ──────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# ── Logs & Debugging ─────────────────────────────────────────────────────────
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Docker & Database Dumps ──────────────────────────────────────────────────
docker-compose.override.yml
*.sql
*.sql.gz
*.dump
backups/

# ── Editor & IDE Configuration ───────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# ── Operating System Artifacts ───────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ── Temporary & Backup Files ─────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.local
