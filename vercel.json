{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "doc-trust-one.vercel.app"
          }
        }
      ],
      "destination": "https://doctrust-backend.onrender.com/api/:path*"
    }
  ]
}
