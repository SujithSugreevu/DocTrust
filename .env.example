# DocTrust Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL
# Neon supplies DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED after `neon deploy`.
# DATABASE_URL is preferred by Django when present.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Set only for migrations/admin tasks after confirming the direct URL works.
# DOCTRUST_USE_UNPOOLED_DATABASE=1
NEON_BRANCH=
POSTGRES_DB=doctrust_db
POSTGRES_USER=doctrust_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password

# Django
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Demo account repair (disabled by default; never commit secret values)
# DOCTRUST_DEMO_MODE=1 is required together with --allow-production-demo when
# deliberately repairing demo accounts against a production database.
DOCTRUST_DEMO_MODE=False
# DOCTRUST_DEMO_ADMIN_PASSWORD=<temporary secret>
# DOCTRUST_DEMO_EMPLOYEE_PASSWORD=<temporary secret>
# DOCTRUST_MOCK_EMPLOYEE_PASSWORD=<optional local-only fixture password>

# Render backend production values (configure these in the Render service,
# not in Git):
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<random production-only secret>
# DJANGO_ALLOWED_HOSTS=doctrust-backend.onrender.com
# DATABASE_URL=<Neon pooled PostgreSQL URL>
# FRONTEND_BASE_URL=https://doc-trust-one.vercel.app
# DJANGO_CORS_ALLOWED_ORIGINS=https://doc-trust-one.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://doc-trust-one.vercel.app
# DOCUMENT_STORAGE_ROOT=/tmp/doctrust/storage
# Render /tmp storage is ephemeral; use the configured persistent disk or
# durable object storage before relying on uploads in production.

# Email configuration (Console backend is active by default in DEBUG; configure SMTP for real email delivery)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=CHANGE_ME_smtp_username
DJANGO_EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DJANGO_DEFAULT_FROM_EMAIL=DocTrust Security <noreply@example.com>
FRONTEND_BASE_URL=http://localhost:5173
# Do not set VITE_API_BASE_URL: browser requests intentionally stay same-origin
# and use the Vite proxy locally or the Vercel /api rewrite in production.
# Optional: comma-separated additional trusted origins (local 5173, 5174, 5175 are included automatically)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

# Private Document Storage & Quota
# Local development can use ./storage. Render must mount a persistent disk and
# set this to its mount path, for example /var/data/doctrust/storage.
# DOCUMENT_STORAGE_ROOT=./storage
# MAX_UPLOAD_MB=50
# USER_STORAGE_QUOTA_MB=500
# DELETED_RETENTION_DAYS=30

